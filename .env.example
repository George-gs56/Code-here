# CodeSphere Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Management
JWT_SECRET=codesphere_super_secret_jwt_key_2026_change_in_production

# PostgreSQL / Supabase Database Connection
# If DATABASE_URL is provided, standard pg connection pool is used.
# If omitted, CodeSphere initializes embedded PostgreSQL engine for immediate local execution.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesphere

# Supabase Auth / Client Config (Optional when using direct DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
